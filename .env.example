# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Create OAuth 2.0 Client ID (Web Application)
# 2. Set authorized redirect URIs to: http://localhost:3000/api/auth/callback/google
# 3. Download credentials and paste the values below

GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Gmail API Scopes (do not modify unless needed)
# Current scope: Gmail read-only access
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# Generate AUTH_SECRET with:
# $ openssl rand -base64 32

AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================
# NODE_ENV=development
# DEBUG=true

# ============================================
# DATABASE CONFIGURATION
# ============================================
# DATABASE_URL=sqlite:./jobs.db
# (SQLite file path is handled by the application)

# ============================================
# SECURITY NOTES
# ============================================
# 1. Never commit .env.local or any .env.* files
# 2. Each developer should create their own .env.local
# 3. Production credentials should use GitHub Secrets
# 4. Rotate CLIENT_SECRET and AUTH_SECRET regularly
# 5. Use different credentials for dev/staging/production
# 6. Keep sensitive files out of version control
